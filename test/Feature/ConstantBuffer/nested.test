#--- source.hlsl

struct Inner {
  float a;
};

struct Outer {
  Inner i;
  float b;
};

ConstantBuffer<Outer> CB : register(b0);

struct Output {
  float a;
  float b;
};

RWStructuredBuffer<Output> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out[0].a = CB.i.a;
  Out[0].b = CB.b;
}


//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
    DispatchSize: [1, 1, 1]
Buffers:
  - Name: CB
    Format: Hex32
    Data: [ 0x3f800000, 0x40000000 ]
  - Name: Out
    Format: Hex32
    Stride: 8
    FillSize: 8
DescriptorSets:
  - Resources:
    - Name: CB
      Kind: ConstantBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -fvk-use-dx-layout -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o | FileCheck %s

# CHECK: - Name: Out
# CHECK:   Format: Hex32
# CHECK:   Data: [ 0x3F800000, 0x40000000 ]
